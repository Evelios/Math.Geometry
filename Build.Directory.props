<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <Version>0.0.1</Version>
        <PackageVersion>0.0.1</PackageVersion>
        <Product>Math.Geometry</Product>
        <Authors>Thomas Waters</Authors>
        <Copyright>Thomas Waters</Copyright>
        <Company/>
        <PackageTags>geometry, fsharp, f#</PackageTags>
        <PackageLicense>MIT</PackageLicense>

        <RepositoryUrl>https://github.com/Evelios/Math.Geometry</RepositoryUrl>
        <PackageProjectUrl>https://evelios.github.io/Math.Geometry/reference/index.html</PackageProjectUrl>

        <RepositoryType>git</RepositoryType>
        <NeutralLanguage>en-US</NeutralLanguage>

        <FsDocsLicenseLink>https://opensource.org/licenses/MIT</FsDocsLicenseLink>
        <FsDocsReleaseNotesLink>https://www.nuget.org/packages/Math.Geometry/</FsDocsReleaseNotesLink>
        <FsDocsLogoSource>$(MSBuildThisFileDirectory)docs/img/logo.png</FsDocsLogoSource>
        <FsDocsFaviconSource>$(MSBuildThisFileDirectory)docs/img/favicon.ico</FsDocsFaviconSource>
        <FsDocsWarnOnMissingDocs>true</FsDocsWarnOnMissingDocs>
        <FsDocsTheme>fsharp.org</FsDocsTheme>

        <WarnOn>3390;$(WarnOn)</WarnOn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
</Project>